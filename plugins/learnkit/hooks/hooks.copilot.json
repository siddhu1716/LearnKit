{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" sessionStart copilot-cli"
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" userPromptSubmitted copilot-cli"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" postToolUse copilot-cli"
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" postToolUseFailure copilot-cli"
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" preCompact copilot-cli"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PLUGIN_ROOT}/scripts/hook.mjs\" agentStop copilot-cli"
      }
    ]
  }
}